{
  "name": "web-to-api",
  "version": "1.0.0",
  "description": "Turn free web AI chat sessions into a local OpenAI-compatible API",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "web-to-api": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "img"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "cookies:refresh": "tsx src/tools/cookie-refresh.ts",
    "cookies:service": "tsx src/tools/cookie-refresh.ts --print-systemd",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "openai",
    "api",
    "deepseek",
    "kimi",
    "qwen",
    "playwright",
    "browser-automation",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linuxhsj/web-to-api.git"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "hono": "^4.12.10",
    "js-yaml": "^4.1.1",
    "open": "^11.0.0",
    "playwright-core": "^1.59.1",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
